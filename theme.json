{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"customTemplates": [
		{
			"name": "page-consulting",
			"title": "Consulting",
			"postTypes": [ "page" ]
		}
	],
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" },
		{ "name": "header-consulting", "title": "Header (Consulting)", "area": "header" },
		{ "name": "footer-consulting", "title": "Footer (Consulting)", "area": "footer" }
	],
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1240px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "navy", "name": "Crown Navy", "color": "#1B2A4A" },
				{ "slug": "clay", "name": "Clay Red", "color": "#B5401C" },
				{ "slug": "cream", "name": "Finish-Line Cream", "color": "#FBF4E9" },
				{ "slug": "gold", "name": "Medal Gold", "color": "#F4B942" },
				{ "slug": "teal", "name": "Queen City Teal", "color": "#0B6E6F" },
				{ "slug": "sage", "name": "Greenway Sage", "color": "#A8C3A0" },
				{ "slug": "blush", "name": "Dogwood Blush", "color": "#F2C4B0" },
				{ "slug": "ink-muted", "name": "Muted Ink", "color": "#3D4B66" },
				{ "slug": "line", "name": "Line", "color": "#E0D2BB" },
				{ "slug": "white", "name": "White", "color": "#FFFFFF" }
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "fraunces",
					"name": "Fraunces",
					"fontFamily": "Fraunces, Georgia, serif"
				},
				{
					"slug": "dm-sans",
					"name": "DM Sans",
					"fontFamily": "'DM Sans', system-ui, sans-serif"
				},
				{
					"slug": "system",
					"name": "System",
					"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.9375rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.25rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "2.5rem", "fluid": { "min": "1.75rem", "max": "2.5rem" } },
				{ "slug": "xx-large", "name": "Huge", "size": "4rem", "fluid": { "min": "2.25rem", "max": "4rem" } },
				{ "slug": "display", "name": "Display", "size": "7rem", "fluid": { "min": "3rem", "max": "7rem" } }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "1.5rem" },
				{ "slug": "50", "name": "L", "size": "clamp(1.75rem, 3vw, 2.5rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(2.5rem, 5vw, 4rem)" },
				{ "slug": "70", "name": "2XL", "size": "clamp(3.5rem, 7vw, 6rem)" },
				{ "slug": "80", "name": "3XL", "size": "clamp(4rem, 9vw, 7.5rem)" }
			],
			"units": [ "px", "rem", "%", "vw" ]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--navy)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--40)",
			"padding": {
				"left": "var(--wp--preset--spacing--40)",
				"right": "var(--wp--preset--spacing--40)"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontWeight": "600",
					"lineHeight": "1.05"
				}
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--navy)" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--navy)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": { "radius": "999px" },
				"typography": { "fontWeight": "700" },
				"spacing": {
					"padding": { "top": "1rem", "bottom": "1rem", "left": "1.75rem", "right": "1.75rem" }
				}
			}
		}
	}
}
